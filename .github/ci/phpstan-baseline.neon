parameters:
	ignoreErrors:
		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: ../../project-management/ExmentPM/Migrate/Exporter.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: ../../project-management/ExmentPM/Migrate/Importer.php

		-
			message: '#^Call to an undefined static method Exceedone\\Exment\\Model\\CustomColumn\:\:selectTargetTable\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: ../../project-management/ExmentPM/LightApiController.php

		-
			message: '#^Variable \$this on left side of \?\? is never defined\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: ../../project-management/ExmentPM/PluginEvent.php

		-
			message: '#^Call to static method user\(\) on an unknown class Admin\.$#'
			identifier: class.notFound
			count: 2
			path: ../../project-management/ExmentPM/PmPortalController.php

		-
			message: '#^Static call to instance method Exceedone\\Exment\\Model\\Menu\:\:where\(\)\.$#'
			identifier: method.staticCall
			count: 2
			path: ../../project-management/ExmentPM/PortalUpgrade.php
