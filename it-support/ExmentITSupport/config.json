{
    "plugin_name": "ExmentITSupport",
    "uuid": "6b1f2c0e-7a4d-4e8b-9c35-1d2e8f4a7b90",
    "plugin_view_name": "Exment Plugin Help Desk（サポート窓口）",
    "description": "ITサポート・ヘルプデスク。メール受付・ログインなしの進み具合の共有・顧客ポータル・SLA・ナレッジ（FAQ）・IT資産・エラーログからの自動起票・レポート。Exment の標準テーブル上に作るので、項目や画面はあとから自由に変えられます。",
    "author": "Exceedone",
    "version": "1.0.9",
    "plugin_type": "page,batch,event",
    "uri": "exment_it_support",
    "event_triggers": ["saving", "saved"],
    "batch_cron": "*/5 * * * *",
    "templates": false,
    "route": [
        { "method": "get", "uri": "", "function": "index" },
        { "method": "get", "uri": "setup", "function": "setup" },
        { "method": "post", "uri": "setup", "function": "postSetup" },
        { "method": "get", "uri": "settings", "function": "settings" },
        { "method": "post", "uri": "settings", "function": "postSettings" },
        { "method": "post", "uri": "settings/mail-test", "function": "postMailTest" },
        { "method": "post", "uri": "settings/chat-test", "function": "postChatTest" },
        { "method": "post", "uri": "settings/fetch-now", "function": "postFetchNow" },
        { "method": "post", "uri": "settings/intake-key", "function": "postIntakeKey" },
        { "method": "post", "uri": "settings/intake-source", "function": "postIntakeSource" },
        { "method": "post", "uri": "settings/intake-source/{id}", "function": "postIntakeSourceUpdate" },
        { "method": "post", "uri": "settings/alert-shared-key", "function": "postAlertSharedKey" },
        { "method": "get", "uri": "dashboard", "function": "dashboard" },
        { "method": "get", "uri": "report.csv", "function": "reportCsv" },
        { "method": "get", "uri": "new", "function": "newTicket" },
        { "method": "post", "uri": "new", "function": "postNewTicket" },
        { "method": "get", "uri": "api/list", "function": "apiList", "middleware_except": ["admin.bootstrap", "admin.pjax"] },
        { "method": "get", "uri": "api/ticket/{id}", "function": "apiTicket", "middleware_except": ["admin.bootstrap", "admin.pjax"] },
        { "method": "get", "uri": "knowledge/search", "function": "knowledgeSearch", "middleware_except": ["admin.bootstrap", "admin.pjax"] },
        { "method": "get", "uri": "my", "function": "myTickets" },
        { "method": "post", "uri": "bulk", "function": "postBulk" },
        { "method": "get", "uri": "ticket/{id}", "function": "ticket" },
        { "method": "post", "uri": "ticket/{id}/reply", "function": "postReply" },
        { "method": "post", "uri": "ticket/{id}/update", "function": "postUpdate" },
        { "method": "post", "uri": "ticket/{id}/share", "function": "postShare" },
        { "method": "post", "uri": "ticket/{id}/to-knowledge", "function": "postToKnowledge" },
        { "method": "post", "uri": "ticket/{id}/merge", "function": "postMerge" },
        { "method": "post", "uri": "ticket/{id}/problem", "function": "postTicketProblem" },
        { "method": "post", "uri": "ticket/{id}/pm-issue", "function": "postPmIssue" },
        { "method": "post", "uri": "ticket/{id}/quote", "function": "postQuote" },
        { "method": "get", "uri": "api/pm-projects", "function": "apiPmProjects", "middleware_except": ["admin.bootstrap", "admin.pjax"] },
        { "method": "post", "uri": "settings/catalog-templates", "function": "postCatalogTemplates" },
        { "method": "get", "uri": "approval/{id}", "function": "approval" },
        { "method": "post", "uri": "approval/{id}", "function": "postApproval" },
        { "method": "get", "uri": "boxes", "function": "boxes" },
        { "method": "post", "uri": "boxes/{id}/web-form", "function": "postBoxWebForm" },
        { "method": "get", "uri": "problems", "function": "problems" },
        { "method": "get", "uri": "problem/{id}", "function": "problem" },
        { "method": "post", "uri": "problem/{id}", "function": "postProblem" },
        { "method": "post", "uri": "ticket/{id}/lock", "function": "postLock", "middleware_except": ["admin.bootstrap", "admin.pjax"] }
    ]
}
