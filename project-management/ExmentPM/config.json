{
    "plugin_name": "ExmentPM",
    "uuid": "00da3e93-1a24-4f44-b993-d61367e43649",
    "plugin_view_name": "Exment Plugin PM（プロジェクト管理）",
    "description": "プロジェクト管理（課題・ボード・ガントチャート・Wiki・ファイル・データ移行）。Exment の標準テーブル上に構築します。",
    "author": "Exceedone",
    "version": "1.7.7",
    "plugin_type": "page,validator,event,batch",
    "uri": "exment_pm",
    "event_triggers": ["saving", "saved"],
    "batch_hour": -1,
    "templates": false,
    "route": [
        { "method": "get", "uri": "", "function": "index" },
        { "method": "get", "uri": "setup", "function": "setup" },
        { "method": "post", "uri": "setup", "function": "postSetup" },
        { "method": "get", "uri": "settings", "function": "settings" },
        { "method": "post", "uri": "settings/upgrade", "function": "postUpgrade" },
        { "method": "post", "uri": "settings/migrate/export", "function": "postMigrateExport" },
        { "method": "post", "uri": "settings/migrate/import", "function": "postMigrateImport" },
        { "method": "post", "uri": "form-style", "function": "postFormStyle" },

        { "method": "get", "uri": "asset/{name}", "function": "asset", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
        { "method": "get", "uri": "lightapi/table/{tableKey}/schema", "function": "apiSchema", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
        { "method": "get", "uri": "lightapi/data/{tableKey}", "function": "apiList", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
