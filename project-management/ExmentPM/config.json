        { "method": "get", "uri": "lightapi/data/{tableKey}/create", "function": "apiCreateForm", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
        { "method": "get", "uri": "lightapi/data/{tableKey}/{id}/edit", "function": "apiEditForm", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
        { "method": "patch", "uri": "lightapi/data/{tableKey}/{id}", "function": "apiUpdate", "middleware_except": ["admin.morph", "admin.bootstrap"] },
        { "method": "delete", "uri": "lightapi/data/{tableKey}/{id}", "function": "apiDestroy", "middleware_except": ["admin.morph", "admin.bootstrap"] },
        { "method": "get", "uri": "lightapi/data/{tableKey}/{id}", "function": "apiFind", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
        { "method": "get", "uri": "lightapi/lookup/{tableKey}", "function": "apiLookup", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },
