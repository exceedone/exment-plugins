        { "method": "get", "uri": "lightapi/card/{kind}/{id}", "function": "apiCard", "middleware_except": ["admin.morph", "admin.log", "admin.bootstrap"] },

        { "method": "get", "uri": "search", "function": "searchIssues" },
        { "method": "get", "uri": "projects", "function": "topbarProjects" },
        { "method": "get", "uri": "ranking", "function": "ranking" },
        { "method": "get", "uri": "view/{key}", "function": "viewIssue" },
        { "method": "get", "uri": "projects/{code}", "function": "viewProject" },
        { "method": "get", "uri": "{id}", "function": "show" },
        { "method": "get", "uri": "{id}/embed/{kind}", "function": "embed" },
        { "method": "get", "uri": "{id}/issue_details", "function": "issueDetails" },
        { "method": "get", "uri": "{id}/data", "function": "projectData" },
        { "method": "get", "uri": "{id}/stamp", "function": "projectStamp" },
        { "method": "post", "uri": "{id}/issues/bulk", "function": "bulkUpdate" },
        { "method": "get", "uri": "{id}/issue/{issue_id}", "function": "issueDetail" },
        { "method": "post", "uri": "{id}/issue/{issue_id}/comment", "function": "postComment" },
        { "method": "post", "uri": "{id}/issue/{issue_id}/read", "function": "issueRead" },
        { "method": "post", "uri": "{id}/read-all", "function": "projectReadAll" },
        { "method": "get", "uri": "{id}/archived", "function": "archivedIssues" },
        { "method": "post", "uri": "{id}/issue/{issue_id}/mail", "function": "mailIssue" },
        { "method": "get", "uri": "{id}/issue/{issue_id}/move", "function": "issueMoveTargets" },
        { "method": "post", "uri": "{id}/issue/{issue_id}/move", "function": "moveIssue" },
        { "method": "post", "uri": "{id}/issue/{issue_id}/delete", "function": "deleteIssue" },
