        { "method": "post", "uri": "{id}/comment/{comment_id}/review", "function": "reviewComment" },
        { "method": "post", "uri": "{id}/star", "function": "toggleStar" },
        { "method": "get", "uri": "{id}/git_repo", "function": "gitRepo" },
        { "method": "post", "uri": "{id}/git_repo", "function": "postGitRepo" },
        { "method": "get", "uri": "{id}/git_keys", "function": "gitKeys" },
        { "method": "post", "uri": "{id}/git_key_remove", "function": "postGitKeyRemove" },
        { "method": "post", "uri": "{id}/git_token", "function": "postGitToken" },
        { "method": "post", "uri": "{id}/ai/suggest", "function": "aiSuggest" },
        { "method": "post", "uri": "{id}/ai/feedback", "function": "aiFeedback" },
        { "method": "get", "uri": "{id}/ai/state", "function": "aiState" },
        { "method": "post", "uri": "{id}/ai/test", "function": "aiTest" },
        { "method": "post", "uri": "{id}/delete", "function": "deleteProject" }
    ]
}
